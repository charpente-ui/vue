{
    "name": "@charpente-ui/vue",
    "version": "2.10.1",
    "description": "Headless, unstyled Vue 3 components for accessible forms. Logic only, zero CSS.",
    "type": "module",
    "scripts": {
        "dev": "vite --config playground/vite.config.ts",
        "docs:dev": "vitepress dev docs --port 5180 --strictPort",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs --port 5181 --strictPort",
        "lint:js": "eslint --fix .",
        "lint": "npm-run-all --parallel lint:*",
        "build": "vite build",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:all": "run-s test:coverage test:e2e",
        "prepare": "husky",
        "prepack": "npm run build",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=22"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@front-factory/eslint-config": "^3.0.0",
        "@frontfactory/vitepress-theme": "^1.6.0",
        "@playwright/test": "^1.63.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.1",
        "@vue/language-core": "^3.3.11",
        "@vue/test-utils": "^2.5.0",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "npm-run-all2": "^9.0.3",
        "semantic-release": "^25.0.9",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.0",
        "vitepress": "^2.0.0-alpha.20",
        "vitest": "^5.0.1",
        "vue": "^3.5.42"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "keywords": [
        "vue",
        "vue3",
        "headless",
        "headless-ui",
        "unstyled",
        "ui",
        "components",
        "component-library",
        "form",
        "accessibility",
        "a11y",
        "typescript"
    ],
    "license": "MIT",
    "homepage": "https://github.com/charpente-ui/vue",
    "bugs": {
        "url": "https://github.com/charpente-ui/vue/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/charpente-ui/vue.git"
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
