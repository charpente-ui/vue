{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "autoMemoryEnabled": true,
    "model": "opusplan",
    "effortLevel": "medium",
    "env": {
        "INIT_CLAUDE_GENERATED": "2"
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\""
                    }
                ]
            }
        ]
    },
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Write",
            "Edit",
            "MultiEdit",
            "Glob",
            "Grep",
            "LS",
            "Bash(*)",
            "Bash(npm run *)",
            "Bash(npm test*)",
            "Bash(npm ci)",
            "Bash(npm install)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git branch*)",
            "Bash(git switch *)",
            "Bash(git checkout -b *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git pull *)",
            "Bash(git fetch*)",
            "Bash(git stash *)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(git merge *)",
            "Bash(git rebase *)",
            "Bash(npm install *)",
            "Bash(npm i *)",
            "Bash(npm uninstall *)",
            "Bash(npm update *)",
            "Bash(npx *)"
        ],
        "deny": [
            "Bash(git push *)",
            "Bash(rm -r*)",
            "Bash(mv **/.env* *)",
            "Bash(cp **/.env* *)",
            "Bash(npm publish *)",
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.development)",
            "Read(./.env.test)",
            "Read(./.env.staging)",
            "Read(./.env.production)",
            "Read(./.env.*.local)",
            "Read(./secrets/**)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.gnupg/**)",
            "Read(./package-lock.json)",
            "Read(./pnpm-lock.yaml)",
            "Read(./yarn.lock)",
            "Read(./bun.lock)",
            "Read(./bun.lockb)",
            "Read(./composer.lock)",
            "Read(./node_modules/**)",
            "Read(./vendor/**)",
            "Read(./dist/**)",
            "Read(./build/**)",
            "Read(./.next/**)",
            "Read(./.nuxt/**)",
            "Read(./.output/**)",
            "Read(./coverage/**)",
            "Read(./.playwright-mcp/**)",
            "Edit(./.env)",
            "Edit(./.env.local)",
            "Edit(./.env.development)",
            "Edit(./.env.test)",
            "Edit(./.env.staging)",
            "Edit(./.env.production)",
            "Edit(./.env.*.local)",
            "Bash(rm -rf *)",
            "Bash(rm -fr *)",
            "Bash(rm -r -f *)",
            "Bash(rm -f -r *)",
            "Bash(sudo *)",
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(chmod 777 *)",
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git reset --hard*)",
            "Bash(git clean *)",
            "Bash(npm publish*)"
        ]
    }
}
